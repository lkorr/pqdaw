# T0.2-fix1 mutation check: pq_queue_mutation runs the 64-byte-payload queue stress drivers against copies
# of spsc_ring.h / mpsc_queue.h whose tryPop acquire load is weakened to relaxed. Built with everything
# else (so it keeps compiling), not registered with CTest: it reports DETECTED / NOT DETECTED, and the
# result is recorded in bench/RESULTS.md. The shipping headers are never modified.

set(_pq_mutant_dir ${CMAKE_CURRENT_BINARY_DIR}/mutant_include)

# Copies <src> to <dst>, replacing the first std::memory_order_acquire after <anchor> with relaxed, and
# defines <macro> at the top so the consumer can prove it compiled against the mutant.
function(pq_make_queue_mutant src dst anchor macro)
  file(READ ${src} txt)
  string(FIND "${txt}" "${anchor}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "queue mutation: anchor '${anchor}' not found in ${src}")
  endif()
  string(SUBSTRING "${txt}" 0 ${at} head)
  string(SUBSTRING "${txt}" ${at} -1 tail)
  set(acq "std::memory_order_acquire")
  string(FIND "${tail}" "${acq}" a)
  if(a EQUAL -1)
    message(FATAL_ERROR "queue mutation: no acquire after '${anchor}' in ${src}")
  endif()
  string(LENGTH "${acq}" n)
  string(SUBSTRING "${tail}" 0 ${a} t1)
  math(EXPR b "${a} + ${n}")
  string(SUBSTRING "${tail}" ${b} -1 t2)
  file(WRITE ${dst}.tmp "#define ${macro} 1\n// GENERATED by tests/core/queue_mutation.cmake from ${src}: DO NOT SHIP.\n${head}${t1}std::memory_order_relaxed /* MUTANT */${t2}")
  configure_file(${dst}.tmp ${dst} COPYONLY)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${src})
endfunction()

pq_make_queue_mutant(${PQ_SOURCE_DIR}/src/core/include/pq/core/spsc_ring.h
  ${_pq_mutant_dir}/pq/core/spsc_ring.h "bool tryPop(T& out)" PQ_QUEUE_MUTANT_SPSC_TRYPOP_RELAXED)
pq_make_queue_mutant(${PQ_SOURCE_DIR}/src/core/include/pq/core/mpsc_queue.h
  ${_pq_mutant_dir}/pq/core/mpsc_queue.h "bool tryPop(T& out)" PQ_QUEUE_MUTANT_MPSC_TRYPOP_RELAXED)

add_executable(pq_queue_mutation ${CMAKE_CURRENT_SOURCE_DIR}/core/queue_mutation_main.cpp)
# BEFORE: the mutant headers shadow pq_core's for "pq/core/spsc_ring.h" and "pq/core/mpsc_queue.h"; their
# own includes (aligned_buffer.h, cache_line.h) fall through to pq_core's include directory.
target_include_directories(pq_queue_mutation BEFORE PRIVATE ${_pq_mutant_dir})
target_link_libraries(pq_queue_mutation PRIVATE pq_core)
pq_target_defaults(pq_queue_mutation)
