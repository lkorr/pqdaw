// Biquad: the general second-order IIR section, transposed direct form II (two states, the form with the best
// float32 behaviour of the direct forms):
//
//   y = b0·x + s1,   s1 ← b1·x + s2 − a1·y,   s2 ← b2·x − a2·y          (a0 normalised to 1)
//
// `biquad` takes the five coefficients as params (wire anything into them). The designers below compute them from
// cutoff / q / gain with the RBJ "Audio EQ Cookbook" formulas, written with K = tan(π·cutoff/sr) (the same
// bilinear-transform designs, without cos/sin). Coefficients run once per block unless their inputs are modulated.
// For fast or audio-rate modulation prefer `svf`: a direct-form biquad's states are not those of the analog filter,
// so jumping coefficients can click; the SVF's are.
patch biquad {
  in    x  : audio
  param b0 = 1 @label("b0")
  param b1 = 0 @label("b1")
  param b2 = 0 @label("b2")
  param a1 = 0 @label("a1")
  param a2 = 0 @label("a2")
  out   out : audio

  y   = b0 * x + s1
  s1  = z1(b1 * x + s2 - a1 * y)
  s2  = z1(b2 * x - a2 * y)
  out = y
}

// 12 dB/oct low-pass (q = 0.7071: Butterworth).
patch biquad_lowpass {
  in    x      : audio
  param cutoff = 1kHz   [20Hz..20kHz] @unit(Hz) @curve(exp) @label("Cutoff")
  param q      = 0.7071 [0.1..40]     @curve(exp) @label("Q")
  out   out : audio

  K  = tan(3.141592653589793 * clip(cutoff, 0, 0.49 * sr) / sr)
  n  = 1 / (1 + K / q + K * K)
  b0 = K * K * n
  out = biquad(x, b0: b0, b1: 2 * b0, b2: b0, a1: 2 * (K * K - 1) * n, a2: (1 - K / q + K * K) * n)
}

// 12 dB/oct high-pass.
patch biquad_highpass {
  in    x      : audio
  param cutoff = 1kHz   [20Hz..20kHz] @unit(Hz) @curve(exp) @label("Cutoff")
  param q      = 0.7071 [0.1..40]     @curve(exp) @label("Q")
  out   out : audio

  K  = tan(3.141592653589793 * clip(cutoff, 0, 0.49 * sr) / sr)
  n  = 1 / (1 + K / q + K * K)
  out = biquad(x, b0: n, b1: -2 * n, b2: n, a1: 2 * (K * K - 1) * n, a2: (1 - K / q + K * K) * n)
}

// Band-pass, 0 dB at the cutoff (RBJ "constant 0 dB peak gain").
patch biquad_bandpass {
  in    x      : audio
  param cutoff = 1kHz   [20Hz..20kHz] @unit(Hz) @curve(exp) @label("Cutoff")
  param q      = 0.7071 [0.1..40]     @curve(exp) @label("Q")
  out   out : audio

  K  = tan(3.141592653589793 * clip(cutoff, 0, 0.49 * sr) / sr)
  n  = 1 / (1 + K / q + K * K)
  b0 = K / q * n
  out = biquad(x, b0: b0, b1: 0, b2: -b0, a1: 2 * (K * K - 1) * n, a2: (1 - K / q + K * K) * n)
}

// Notch at the cutoff; q sets its width.
patch biquad_notch {
  in    x      : audio
  param cutoff = 1kHz   [20Hz..20kHz] @unit(Hz) @curve(exp) @label("Cutoff")
  param q      = 0.7071 [0.1..40]     @curve(exp) @label("Q")
  out   out : audio

  K  = tan(3.141592653589793 * clip(cutoff, 0, 0.49 * sr) / sr)
  n  = 1 / (1 + K / q + K * K)
  b0 = (1 + K * K) * n
  a1 = 2 * (K * K - 1) * n
  out = biquad(x, b0: b0, b1: a1, b2: b0, a1: a1, a2: (1 - K / q + K * K) * n)
}

// Second-order allpass: phase −180° at the cutoff, q sets how fast it turns.
patch biquad_allpass {
  in    x      : audio
  param cutoff = 1kHz   [20Hz..20kHz] @unit(Hz) @curve(exp) @label("Cutoff")
  param q      = 0.7071 [0.1..40]     @curve(exp) @label("Q")
  out   out : audio

  K  = tan(3.141592653589793 * clip(cutoff, 0, 0.49 * sr) / sr)
  n  = 1 / (1 + K / q + K * K)
  a1 = 2 * (K * K - 1) * n
  a2 = (1 - K / q + K * K) * n
  out = biquad(x, b0: a2, b1: a1, b2: 1, a1: a1, a2: a2)
}

// Peaking EQ (bell), RBJ: boost and cut mirror each other.
patch biquad_peak {
  in    x      : audio
  param cutoff = 1kHz   [20Hz..20kHz] @unit(Hz) @curve(exp) @label("Frequency")
  param q      = 0.7071 [0.1..40]     @curve(exp) @label("Q")
  param gain   = 0dB    [-24dB..24dB] @unit(dB) @label("Gain")
  out   out : audio

  K  = tan(3.141592653589793 * clip(cutoff, 0, 0.49 * sr) / sr)
  A  = sqrt(gain)             // 10^(dB/40)
  n  = 1 / (1 + K / (q * A) + K * K)
  a1 = 2 * (K * K - 1) * n
  out = biquad(x, b0: (1 + K * A / q + K * K) * n, b1: a1, b2: (1 - K * A / q + K * K) * n, a1: a1,
               a2: (1 - K / (q * A) + K * K) * n)
}

// Low shelf, RBJ (q = 0.7071: the steepest shelf without overshoot).
patch biquad_lowshelf {
  in    x      : audio
  param cutoff = 300Hz  [20Hz..20kHz] @unit(Hz) @curve(exp) @label("Frequency")
  param q      = 0.7071 [0.1..40]     @curve(exp) @label("Q")
  param gain   = 0dB    [-24dB..24dB] @unit(dB) @label("Gain")
  out   out : audio

  K  = tan(3.141592653589793 * clip(cutoff, 0, 0.49 * sr) / sr)
  A  = sqrt(gain)
  sA = sqrt(A) * K / q        // √A · K/q
  n  = 1 / (A + K * K + sA)
  out = biquad(x, b0: A * (1 + A * K * K + sA) * n, b1: 2 * A * (A * K * K - 1) * n, b2: A * (1 + A * K * K - sA) * n,
               a1: 2 * (K * K - A) * n, a2: (A + K * K - sA) * n)
}

// High shelf, RBJ.
patch biquad_highshelf {
  in    x      : audio
  param cutoff = 3kHz   [20Hz..20kHz] @unit(Hz) @curve(exp) @label("Frequency")
  param q      = 0.7071 [0.1..40]     @curve(exp) @label("Q")
  param gain   = 0dB    [-24dB..24dB] @unit(dB) @label("Gain")
  out   out : audio

  K  = tan(3.141592653589793 * clip(cutoff, 0, 0.49 * sr) / sr)
  A  = sqrt(gain)
  sA = sqrt(A) * K / q
  n  = 1 / (1 + A * K * K + sA)
  out = biquad(x, b0: A * (A + K * K + sA) * n, b1: 2 * A * (K * K - A) * n, b2: A * (A + K * K - sA) * n,
               a1: 2 * (A * K * K - 1) * n, a2: (1 + A * K * K - sA) * n)
}
