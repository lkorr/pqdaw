// The circuit models of Auto Filter (T4.11, QUESTIONS Q133), shared with Operator's filter (T4.12-fix1): zero-delay-
// feedback filter sections whose nonlinearity Live's circuit names describe (OSR, MS2, SMP, PRD; Clean is the plain
// TPT SVF, filters/svf_fast.pqp). Each takes the prewarped integrator gain g = tan(π·fc/sr) as a signal (so it may
// move per sample, per channel or per voice), its resonance as `k` and the drive `d` (level-compensated: the
// nonlinear terms see d·v and are divided by d, so drive changes the character, not the level). For small signals
// every model is the linear filter.
//   af_osr     SVF (damping k) + soft input stage + hard diode on the band-pass state; closed form (no Newton)
//   af_ms2     SVF (damping k) whose positive resonance feedback saturates (tanh); `solve`, 2 Newton iterations
//   af_smp     af_ms2 with a saturating input stage and an asymmetric feedback curve (even harmonics); 2 iterations
//   af_ladder  four TPT one-poles after a saturating input pair (feedback k on y4, 4 = the linear ladder's self-
//              oscillation); `solve`, 1 iteration; Xpander pole mixing of the response weights at 12 or 24 dB
// The SVF models return (band, low); the caller mixes the responses (hp = x − k·band − low, notch = x − k·band).
// Auto Filter's resonance law: k = √2·(1 − res) for the SVF models, ladder feedback 4·res (res 0 … 125 %: the
// models self-oscillate from 100 %). Operator's: SVF damping 2·(1 − r), ladder feedback 4·r, r = 0.99·res (they
// stop just short of self-oscillation; operator.pqp, QUESTIONS T4.12-fix1).

// OSR: TPT SVF after a soft input stage (xs = tanh(d·x)/d), a hard diode on the band-pass state (knee ±1/d,
// slope 4 beyond). Closed form:
//   a·bp + 4g·(bp − clip(bp, ±t)) = c,  a = 1 + g·(g + k),  c = g·(xs − s2) + s1,  t = 1/d
//   bp = c/a when |c/a| ≤ t, else (c + 4g·t·sign)/(a + 4g)   (the left side increases with bp: one solution)
patch af_osr {
  in    x : audio
  in    g : audio
  param k = 1.4142 [-1..100]
  param d = 1      [1..16]
  out   band : audio
  out   low  : audio

  t   = 1 / d
  xs  = fast_tanh(d * x) / d
  a   = 1 + g * (g + k)
  c   = g * (xs - s2) + s1
  bl  = c / a
  sg  = bl > t ? 1 : bl < -t ? -1 : 0
  gd  = 4 * g
  bp  = (c + gd * t * sg) / (a + gd * abs(sg))
  lp  = g * bp + s2
  s1  = z1(2 * bp - s1)
  s2  = z1(2 * lp - s2)
  band = bp
  low  = lp
}

// MS2: TPT SVF whose positive resonance feedback saturates: hp = x − lp − 2·bp + (2 − k)·tanh(d·bp)/d.
patch af_ms2 {
  in    x : audio
  in    g : audio
  param k = 1.4142 [-1..100]
  param d = 1      [1..16]
  out   band : audio
  out   low  : audio

  kr  = 2 - k
  bl  = (g * (x - s2) + s1) / (1 + g * (g + k))
  solve(iterations: 2) {
    unknown bp = bl
    bp == s1 + g * (x - (g + 2) * bp - s2 + kr * fast_tanh(d * bp) / d)
  }
  lp  = g * bp + s2
  s1  = z1(2 * bp - s1)
  s2  = z1(2 * lp - s2)
  band = bp
  low  = lp
}

// SMP: between MS2 and PRD: a saturating input stage (as PRD's) and MS2's saturating resonance feedback, but
// asymmetric (so it adds even harmonics): hp = tanh(d·x)/d − lp − 2·bp + (2 − k)·a(d·bp)/d, a(v) = t + t²/4 with
// t = tanh(v) (a(0) = 0 and slope 1 at 0: small signals see the linear SVF; increasing, bounded in [−3/4, 5/4]).
patch af_smp {
  in    x : audio
  in    g : audio
  param k = 1.4142 [-1..100]
  param d = 1      [1..16]
  out   band : audio
  out   low  : audio

  kr  = 2 - k
  xs  = fast_tanh(d * x) / d
  bl  = (g * (xs - s2) + s1) / (1 + g * (g + k))
  solve(iterations: 2) {
    unknown bp = bl
    bp == s1 + g * (xs - (g + 2) * bp - s2 + kr * (ts + 0.25 * ts * ts) / d)
  }
  ts  = fast_tanh(d * bp)
  lp  = g * bp + s2
  s1  = z1(2 * bp - s1)
  s2  = z1(2 * lp - s2)
  band = bp
  low  = lp
}

// PRD: four TPT one-poles (G = g/(1 + g)) after a saturating input pair, u = tanh(d·(x − k·y4))/d. With
// H = 1 − G and the stage states s1 … s4: y4 = G⁴·u + S, S = ((H·s1·G + H·s2)·G + H·s3)·G + H·s4.
// Output: Xpander pole mixing of (u, y1 … y4) for the 12 or 24 dB response of each weight, plus the passband
// compensation k·(wLP + wN)·y4 (M4 review M12): the feedback divides the low passband by 1 + k (−6.8 dB at Auto
// Filter's default 30 %, −14 dB at 100 %), and adding k·y4 (= k·u at DC) restores unity there for the lowpass and
// the notch, so switching circuit models keeps the level (the resonance peak rises with the passband, as on a
// bass-compensated ladder). High-pass and band-pass are left alone (their passbands are not divided).
// The mix coefficients are smoothed gains (M4 review M13: resonance and morph move them).
patch af_ladder {
  in    x     : audio
  in    slope : real const = 0
  in    g : audio
  param k = 1.2    [0..5]
  param d = 1      [1..16]
  param wLP = 1 [0..1]
  param wBP = 0 [0..1]
  param wHP = 0 [0..1]
  param wN  = 0 [0..1]
  out   y : audio

  G   = g / (1 + g)
  H   = 1 - G
  G2  = G * G
  G4  = G2 * G2
  S   = ((H * s1 * G + H * s2) * G + H * s3) * G + H * s4
  lin = (G4 * x + S) / (1 + k * G4)
  u   = fast_tanh(d * (x - k * y4)) / d
  solve(iterations: 1) {
    unknown y4 = lin
    y4 == G4 * u + S
  }
  y1 = G * u + H * s1
  y2 = G * y1 + H * s2
  y3 = G * y2 + H * s3
  s1 = z1(2 * y1 - s1)
  s2 = z1(2 * y2 - s2)
  s3 = z1(2 * y3 - s3)
  s4 = z1(2 * y4 - s4)

  // Pole-mixing coefficients of (u, y1, y2, y3, y4): 24 dB LP (0,0,0,0,1) BP (0,0,4,−8,4) HP (1,−4,6,−4,1)
  // N (1,−4,8,−8,4); 12 dB LP (0,0,1,0,0) BP (0,2,−2,0,0) HP (1,−2,1,0,0) N (1,−2,2,0,0).
  hn  = wHP + wN
  c0  = hn
  c1  = slope >= 0.5 ? -4 * hn : 2 * wBP - 2 * hn
  c2  = slope >= 0.5 ? 4 * wBP + 6 * wHP + 8 * wN : wLP - 2 * wBP + wHP + 2 * wN
  c3  = slope >= 0.5 ? -8 * wBP - 4 * wHP - 8 * wN : 0
  c4  = slope >= 0.5 ? wLP + 4 * wBP + wHP + 4 * wN : 0
  cK  = c4 + k * (wLP + wN)                          // + the passband compensation (M12)
  y   = gain_add(gain_add(gain_add(gain_add(gain(u, c0, start: 1), y1, c1, start: 1), y2, c2, start: 1), y3, c3, start: 1), y4, cK, start: 1)
}
