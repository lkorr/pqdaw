patch Audio46 {
  param monitor = 0 [0..1]
  param volume = 0 [-70..6]
  param pan = 0 [-1..1]
  param gate = 1 [0..1]
  param sendGate = 1 [0..1]
  param mute = 0 [0..1]
  out out : real audio global stereo

  _n3 = 0.002
  _n6 = 1
  _n9 = gain_add(gain(clipPlayer(2), _n6 - monitor, _n3), trackInput(2), monitor, _n3)
  _n12 = 0
  _n16 = volume <= -70 ? _n12 : db_to_gain(volume)
  _n18 = min(_n6, _n6 - pan)
  _n20 = min(_n6, _n6 + pan)
  _n25 = mute < 0.5
  _n27 = _n25 ? sendGate : _n12
  _n28 = _n16 * (_n25 ? gate : _n12)
  _n34 = _n16 * _n27
  out = gain(_n9, (_n18 * _n28, _n20 * _n28), _n3)

  export post = gain(_n9, (_n18 * _n34, _n20 * _n34), _n3)
  export pre = gain(_n9, (_n18 * _n27, _n20 * _n27), _n3)
  export meter = gain(_n9, (_n18 * _n16, _n20 * _n16), _n3)

}
