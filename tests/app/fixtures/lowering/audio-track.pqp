patch Audio6 {
  param volume = 0 [-70..6]
  param pan = 0 [-1..1]
  param gate = 1 [0..1]
  param sendGate = 1 [0..1]
  param mute = 0 [0..1]
  out out : real audio global stereo

  d8 = Group(clipPlayer(3), d79)
  d9 = Value(_n118)
  d10 = Value(_n118)
  d11 = Value(_n118)
  d12 = Value()
  d13 = Value(_n118)
  d14 = Value()
  d15 = Value(_n118)
  d16 = Value()
  d17 = Value()
  d18 = Value(_n118)
  d19 = Value(1)
  d20 = Value(_n118)
  d21 = Value(0.5)
  d22 = Atom_mul(d9, d21)
  _n17 = -0
  d23 = Atom_mux(d22, d19, d20)
  d24 = Atom_sub(d19, d23)
  d25 = Value()
  d26 = Atom_mod(d9, d25)
  d27 = Atom_sub(d19, d26)
  d28 = Value()
  d29 = Atom_mux(d10, d19, d28)
  d30 = Atom_mux(d11, d19, d28)
  d31 = Atom_sub(d19, d14)
  d32 = Atom_min(d19, d31)
  d33 = Atom_mux(d13, d19, d32)
  d34 = Atom_mux(d15, d33, d19)
  d35 = Atom_add(d19, d14)
  d36 = Atom_min(d19, d35)
  d37 = Atom_mux(d13, d12, d36)
  d38 = Atom_mux(d15, d37, d20)
  d39 = Atom_mul(d21, d34)
  d40 = Atom_mul(d21, d38)
  d41 = Atom_mul(d29, d23)
  d42 = Atom_mul(d30, d26)
  d43 = Atom_mul(d29, d24)
  d44 = Atom_mul(d30, d27)
  d45 = Atom_add(d41, d42)
  d46 = Atom_mul(d39, d45)
  d47 = Atom_add(d43, d44)
  d48 = Atom_mul(d39, d47)
  d49 = Atom_sub(d41, d42)
  d50 = Atom_mul(d40, d49)
  d51 = Atom_sub(d43, d44)
  d52 = Atom_mul(d40, d51)
  d53 = Value(-69)
  d54 = Atom_sub(d53, d17)
  d55 = Atom_clip(d54, d20, d19)
  d56 = Atom_max(d18, d55)
  d57 = Atom_db_to_gain(d17)
  d58 = Atom_mux(d56, d57, d20)
  d59 = Atom_sub(d19, d16)
  d60 = Atom_min(d19, d59)
  d61 = Atom_mul(d58, d60)
  d62 = Atom_add(d19, d16)
  d63 = Atom_min(d19, d62)
  d64 = Atom_mul(d58, d63)
  d65 = Atom_channel(d8.input, 0)
  d66 = Atom_channel(d8.input, 1)
  d67 = Atom_add(d48, d52)
  d68 = Atom_mul(d61, d67)
  d69 = Atom_add(d46, d50)
  d70 = Atom_mul(d61, d69)
  d71 = Atom_gain(d65, d70, start: 1)
  d72 = Atom_gain_add(d71, d66, d68, start: 1)
  d73 = Atom_sub(d48, d52)
  d74 = Atom_mul(d64, d73)
  d75 = Atom_sub(d46, d50)
  d76 = Atom_mul(d64, d75)
  d77 = Atom_gain(d65, d76, start: 1)
  d78 = Atom_gain_add(d77, d66, d74, start: 1)
  d79 = Atom_pack(d72, d78)
  _n83 = 0
  _n84 = 1
  _n85 = 0.002
  _n89 = volume <= -70 ? _n83 : db_to_gain(volume)
  _n91 = min(_n84, _n84 - pan)
  _n93 = min(_n84, _n84 + pan)
  _n98 = mute < 0.5
  _n100 = _n98 ? sendGate : _n83
  _n101 = _n89 * (_n98 ? gate : _n83)
  _n107 = _n89 * _n100
  _n118 = 0
  out = gain(d8, (_n91 * _n101, _n93 * _n101), _n85)

  export post = gain(d8, (_n91 * _n107, _n93 * _n107), _n85)
  export pre = gain(d8, (_n91 * _n100, _n93 * _n100), _n85)

}
