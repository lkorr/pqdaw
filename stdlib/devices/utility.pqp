// Utility (SPEC §8; Ableton Live's Utility): channel mode, phase invert, width or mid/side balance, mono, bass mono,
// balance, gain, mute, DC filter. Built from the formulas below (no Live renders yet, SPEC §15 2026-10-24); the
// choices Live does not document are in QUESTIONS Q121.
//
// Everything but bass mono and the DC filter is linear and memoryless, so it collapses into one 2 × 2 matrix that
// is computed once per block from the params (the Control region) and smoothed per sample (one-pole, 2 ms, like
// the mixer's gain, so knob moves and automation never zipper or click):
//
//   channel mode   Stereo (L, R) · Left (L, L) · Right (R, R) · Swap (R, L)              `chan` = 0 … 3
//   phase          L·(invL ? −1 : 1), R·(invR ? −1 : 1)
//   mid / side     M = m·(L + R)/2,  S = s·(L − R)/2,  out L = M + S, R = M − S
//                    Width mode:     m = 1, s = width (0 = mono, 100 % = unchanged, up to 400 %)
//                    Mid/Side mode:  m = min(1, 1 − ms), s = min(1, 1 + ms)   (ms −1 = mid only, +1 = side only)
//                    Mono:           m = 1, s = 0 (overrides both)
//   balance        L·min(1, 1 − balance), R·min(1, 1 + balance)   (the mixer's stereo balance law)
//   gain, mute     gain in dB, −70 dB and below = silence (−inf), mute = 0
//
// Bass mono (`bassMono: 1`, structural: a constant, so off costs nothing) mixes the band below `bassFreq` to mono
// with a Linkwitz–Riley 24 dB/oct crossover: the side signal is high-passed by LR4 (two Butterworth SVF high-passes)
// and the mid signal goes through LR4's allpass (one SVF allpass, q = 1/√2), which is exactly "split L and R with
// LR4, sum the two low bands to mono, add the high bands back": low + high = the allpass, flat in magnitude.
// The crossover frequency `bassFreq` may be modulated at audio rate (TPT SVFs). `audition: 1` plays only the mono
// low band (LP4 of the mid). The DC filter (`dc: 1`) is a 5 Hz DC blocker at the
// input.
//
// Exports: the mid and side signals (after the matrix, before bass mono) and the bass band.
//
// Cost (no bass mono): per sample one 4-channel smoothing step (the per-sample loop) and 4 multiply-adds; with bass
// mono three SVF cores more.
import "../filters/svf_fast.pqp"
import "../filters/dcblock.pqp"

patch utility {
  in    x        : audio stereo
  in    bassMono : real const = 0     // 1: mix the band below bassFreq to mono
  in    audition : real const = 0     // 1 (with bassMono): hear only the mono bass band
  in    dc       : real const = 0     // 1: DC filter at the input
  param chan     = 0      [0..3]          @steps(4) @label("Channel Mode")   // Stereo, Left, Right, Swap
  param invL     = false                  @label("Phase L")
  param invR     = false                  @label("Phase R")
  param width    = 100%   [0%..400%]      @label("Width")
  param msMode   = false                  @label("Mid/Side Mode")
  param ms       = 0      [-1..1]         @label("Mid/Side")
  param mono     = false                  @label("Mono")
  param bassFreq = 120Hz  [50Hz..500Hz]   @unit(Hz) @curve(exp) @label("Bass Mono Freq")
  param balance  = 0      [-1..1]         @label("Balance")
  param gain     = 0dB    [-70dB..35dB]   @unit(dB) @label("Gain")
  param mute     = false                  @label("Mute")
  out   out : audio stereo

  xin = dc >= 0.5 ? dcblock(x, cutoff: 5Hz) : x
  L = xin[0]
  R = xin[1]

  // ---- the matrix (param rate) ----
  cLL = mux(chan, 1, 1, 0, 0)
  cLR = mux(chan, 0, 0, 1, 1)
  cRL = mux(chan, 0, 1, 0, 1)
  cRR = mux(chan, 1, 0, 1, 0)
  pL  = invL ? -1 : 1
  pR  = invR ? -1 : 1
  m   = mono ? 1 : msMode ? min(1, 1 - ms) : 1
  s   = mono ? 0 : msMode ? min(1, 1 + ms) : width
  mL  = 0.5 * m * (pL * cLL + pR * cRL)       // M = mL·L + mR·R
  mR  = 0.5 * m * (pL * cLR + pR * cRR)
  sL  = 0.5 * s * (pL * cLL - pR * cRL)       // S = sL·L + sR·R
  sR  = 0.5 * s * (pL * cLR - pR * cRR)
  g   = mute || gain <= -70dB ? 0 : gain
  oL  = g * min(1, 1 - balance)
  oR  = g * min(1, 1 + balance)

  // ---- smoothing: 2 ms one-pole on every coefficient ----
  // Kept as the distance to the target: e ← (e + t[n−1] − t[n])·c, value = t + e, c = e^(−1/(2 ms·sr)). The
  // distance decays to 0 (and flushes), so a settled coefficient is exactly its target: unity gain is
  // bit-transparent. (v ← v + (t − v)·(1 − c) would stall up to ulp/(2(1 − c)) ≈ 48 ulps from it.) Per sample the
  // loop is one multiply-add per coefficient; the target steps only at block boundaries. `f` (z1(1): 0 at the first
  // sample, then 1) makes the first sample's distance 0, so a new Utility starts at its target instead of fading in
  // from 0 (M4 review L10).
  k = exp(-1 / (0.002 * sr))
  f = z1(1)
  // Without bass mono: out L = aLL·L + aLR·R, out R = aRL·L + aRR·R.
  direct = (oL * (mL + sL), oL * (mR + sR), oR * (mL - sL), oR * (mR - sR))
  dd     = z1(dn)
  dn     = dd * k + (z1(direct) - direct) * f * k
  sd     = direct + dn
  plain  = (sd[0] * L + sd[1] * R, sd[2] * L + sd[3] * R)

  // With bass mono: M and S, filtered, then out = (oL·(M' + S'), oR·(M' − S')).
  split = (mL, mR, sL, sR, oL, oR)
  sp    = z1(sn)
  sn    = sp * k + (z1(split) - split) * f * k
  ss    = split + sn
  M     = ss[0] * L + ss[1] * R
  S     = ss[2] * L + ss[3] * R
  // LR4 crossover from Butterworth SVF cores (svf_core_fast) (k = √2): allpass = x − 2k·band, hp = x − k·band − low, lp = low.
  gx    = tan(3.141592653589793 * clip(bassFreq, 0, 0.49 * sr) / sr)
  ap    = svf_core_fast(M, g: gx, k: 1.4142135623730951)
  Mp    = M - 2.8284271247461903 * ap.band
  h1    = svf_core_fast(S, g: gx, k: 1.4142135623730951)
  S1    = S - 1.4142135623730951 * h1.band - h1.low
  h2    = svf_core_fast(S1, g: gx, k: 1.4142135623730951)
  Sp    = S1 - 1.4142135623730951 * h2.band - h2.low
  low   = svf_core_fast(svf_core_fast(M, g: gx, k: 1.4142135623730951).low, g: gx, k: 1.4142135623730951).low
  bm    = audition >= 0.5 ? (ss[4] * low, ss[5] * low) : (ss[4] * (Mp + Sp), ss[5] * (Mp - Sp))

  out = bassMono >= 0.5 ? bm : plain

  export mid  = bassMono >= 0.5 ? M : 0.5 * (plain[0] + plain[1])
  export side = bassMono >= 0.5 ? S : 0.5 * (plain[0] - plain[1])
  export bass = bassMono >= 0.5 ? low : 0
}
