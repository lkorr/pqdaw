{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "dev: unoptimised, debug info (/Z7), asserts on (static release CRT)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "/Od /Ob0",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/Od /Ob0",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "/DEBUG:FASTLINK /INCREMENTAL"
      }
    },
    {
      "name": "check",
      "inherits": "base",
      "displayName": "check: release optimisation with asserts on (no /DNDEBUG); definition-of-done verification",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "/O2 /Ob2",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Ob2 /Oi /Ot",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/OPT:REF",
        "CMAKE_STATIC_LINKER_FLAGS_RELEASE": ""
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release: fully optimised per translation unit, asserts off (no LTCG; routine verification)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "/O2 /Ob2 /DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Ob2 /Oi /Ot /DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/OPT:REF",
        "CMAKE_STATIC_LINKER_FLAGS_RELEASE": ""
      }
    },
    {
      "name": "ship",
      "inherits": "base",
      "displayName": "ship: release + whole-program optimisation (/GL + /LTCG); shipping builds and recorded benchmarks",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "/O2 /Ob2 /DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Ob2 /Oi /Ot /GL /DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/LTCG /OPT:REF /OPT:ICF",
        "CMAKE_STATIC_LINKER_FLAGS_RELEASE": "/LTCG"
      }
    }
  ],
  "buildPresets": [
    { "name": "check", "configurePreset": "check" },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "ship", "configurePreset": "ship" }
  ],
  "testPresets": [
    { "name": "check", "configurePreset": "check", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^(perf|slow)$" } } },
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^(perf|slow)$" } } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^(perf|slow)$" } } },
    { "name": "ship", "configurePreset": "ship", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" },
      "filter": { "exclude": { "label": "^(perf|slow)$" } } }
  ]
}
