{
  "format": "pqdaw-panel 1",
  "patch": "saturator",
  "title": "Saturator",
  "size": [606, 150],
  "controls": [
    {"type": "knob", "param": "drive", "rect": [0, 24, 58, 100]},
    {"type": "visual", "visual": "transfer", "rect": [60, 0, 150, 150],
     "bind": {"type": "#type", "softClip": "#softClip", "drive": "drive", "output": "output", "dryWet": "dryWet",
              "wsDrive": "wsDrive", "wsLin": "wsLin", "wsCurve": "wsCurve", "wsDamp": "wsDamp", "wsDepth": "wsDepth",
              "wsPeriod": "wsPeriod"}},
    {"type": "label", "text": "Type", "rect": [218, 0, 96, 14]},
    {"type": "chooser", "const": "type", "label": "Type",
     "items": ["Analog Clip", "Soft Sine", "Bass Shaper", "Medium Curve", "Hard Curve", "Sinoid Fold", "Digital Clip", "Waveshaper", "Shaper"],
     "rect": [218, 14, 96, 18], "info": "The saturation curve (a structural setting: changing it recompiles the device, crossfaded)."},
    {"type": "label", "text": "Oversampling", "rect": [218, 36, 96, 14]},
    {"type": "chooser", "const": "hq", "label": "Oversampling", "items": ["Off", "2x", "4x", "8x"], "values": [1, 2, 4, 8],
     "rect": [218, 50, 96, 18], "info": "High quality: runs the curve oversampled, which removes most aliasing (structural)."},
    {"type": "toggle", "const": "softClip", "text": "Soft Clip", "rect": [218, 74, 58, 18],
     "info": "A tanh soft clipper after the output gain (structural)."},
    {"type": "toggle", "const": "color", "text": "Color", "rect": [278, 74, 36, 18],
     "info": "The colour EQ before the drive: a 200 Hz shelf (Base) and a bell (Freq, Width, Depth) (structural)."},
    {"type": "knob", "param": "output", "rect": [214, 96, 52, 54]},
    {"type": "knob", "param": "dryWet", "rect": [266, 96, 52, 54]},
    {"type": "label", "text": "Color", "rect": [324, 0, 112, 14]},
    {"type": "knob", "param": "base", "rect": [324, 14, 56, 58]},
    {"type": "knob", "param": "colorFreq", "rect": [380, 14, 56, 58]},
    {"type": "knob", "param": "colorWidth", "rect": [324, 84, 56, 58]},
    {"type": "knob", "param": "depth", "rect": [380, 84, 56, 58]},
    {"type": "label", "text": "Waveshaper", "rect": [440, 0, 166, 14]},
    {"type": "knob", "param": "wsDrive", "label": "Drive", "rect": [440, 14, 54, 58]},
    {"type": "knob", "param": "wsLin", "rect": [496, 14, 54, 58]},
    {"type": "knob", "param": "wsCurve", "rect": [552, 14, 54, 58]},
    {"type": "knob", "param": "wsDamp", "rect": [440, 84, 54, 58]},
    {"type": "knob", "param": "wsDepth", "rect": [496, 84, 54, 58]},
    {"type": "knob", "param": "wsPeriod", "rect": [552, 84, 54, 58]}
  ]
}
