// Meta Operator (TMM.12; docs/plans/MM.md, SPEC §15 2026-11-01 "meta modules"): four FM operators built from meta
// modules, next to the Live-parity Operator (devices/operator.pqp, untouched). The goal is a circuit that reads at a
// glance: each operator is a Phase accumulator → a Wavetable → an Envelope used as a VCA, and the algorithm decides
// which operator's output modulates which one's phase. Sounding like Live's Operator is not a goal.
//
// OPERATOR X (A … D):
//   accX  = meta_phase_acc(hz, pm)   hz = voice.hz · nX / dX (ratio_hz below: an exact just ratio, two integers, one
//                                    rounding at the multiply); pm = the modulators' sum (the algorithm). The face adds
//                                    its frequency bar in Hz (0 = the ratio exactly), its phase and its amplitude. nX = 0
//                                    stops following the note: the frequency bar is then a fixed frequency.
//   wtX   = meta_wavetable(accX)     reads its table at that phase: a sine by default; draw, shapes, harmonics, keyframes,
//                                    fold / warp / sync on its face (the drawn harmonics of Live's Operator come from here)
//   envX  = meta_envelope(wtX)       a VCA: out = envelope · amount · wave. The amount is the operator's level: a carrier's
//                                    loudness, a modulator's index (amount 1 moves the carrier's phase ±1 cycle)
//
// ALGORITHMS (`algorithm`, structural 1 … 11: Live's topologies, the same table as Operator's). "X → Y": X's output is
// added to Y's phase; carriers are summed to the output; D is on top and can modulate itself (`feedback`, through one
// sample of delay: z1, while `fbOn` is 1):
//    1  D → C → B → A                 carrier A
//    2  (C + D) → B → A               carrier A
//    3  D → C → A,  B → A             carrier A
//    4  C → B → A,  D → A             carrier A
//    5  (B + C + D) → A               carrier A
//    6  D → C → B,  A                 carriers B, A
//    7  D → C,  B → A                 carriers C, A
//    8  (C + D) → B,  A               carriers B, A
//    9  D → C,  B,  A                 carriers C, B, A
//   10  D → C,  D → B,  D → A         carriers C, B, A
//   11  A,  B,  C,  D                 carriers A – D (additive)
// Each routing is a `mux` over the algorithm: a structural constant, so only the chosen arm is compiled and the circuit
// view hides the others (T4.15): the opened circuit shows exactly the live algorithm's wires.
//
// QUALITY (`hq`, structural 1 or 2): the operators run inside `oversample(hq)` (PATCH_LANGUAGE §2.3): at 2 they
// compute at twice the rate and the sum is decimated through the half-bands, so FM sidebands up to (2·sr − 20 kHz) no
// longer fold into the audible band (phase modulation spreads sidebands without a bound: they alias by nature).
//
// OUTPUT: the carriers' sum · velocity (mono, per voice); the voice ends when every carrier's envelope has released
// (its `done`). No filter, LFO, pitch envelope, glide or spread: put Auto Filter after it; an LFO is a Phase accumulator
// with hz 0 into a Wavetable, wireable anywhere.
//
// Cost (per voice-sample, sine tables): 4 × (phasor + 4 ops, a frame-table read, the envelope's ≈ 30 ops) + the routing
// adds. Measured (ship, JIT, 64 voices; bench/RESULTS.md TMM.12-fix1): 6.86 ns without feedback (the default, `fbOn`
// 0), 10.29 ns with D's loop on (`fbOn`: D's phasor, table read and envelope then run sample by sample; D's read
// computed inline after each block's first frame), 22.82 ns with hq; Operator doing the same work 8.97 ns (1.15×; the
// MM review measured 10.13 vs 10.58, 0.96×). A one-frame sine table is read as a sine (≈ 0.4 ns per read, the
// `sine` atom and one FMA), so the band-limited row read (≈ 2.5 ns) is paid only by real wavetables; what remains is
// the curved envelopes and D's per-sample loop (QUESTIONS Q?-TMM.12-a). (TMM.12 measured 13.2 / 19.1 / 44.0 ns.)

patch meta_operator {
  in    algorithm : real const = 1   // 1 … 11 (above)
  in    hq        : real const = 1   // 1, or 2: the operators oversampled ×2
  in    fbOn      : real const = 0   // 1: D's feedback loop exists (off, D's chain runs block-wise: no per-sample loop)
  param nA = 1 [0..32] @steps(33) @label("A ratio")
  param dA = 1 [1..32] @steps(32) @label("A ÷")
  param nB = 1 [0..32] @steps(33) @label("B ratio")
  param dB = 1 [1..32] @steps(32) @label("B ÷")
  param nC = 1 [0..32] @steps(33) @label("C ratio")
  param dC = 1 [1..32] @steps(32) @label("C ÷")
  param nD = 1 [0..32] @steps(33) @label("D ratio")
  param dD = 1 [1..32] @steps(32) @label("D ÷")
  param feedback = 0 [0..1] @label("Feedback")
  out   out  : audio voice mono
  out   done : bool voice mono

  oversample(hq) {
    accA = meta_phase_acc(ratio_hz(nA, dA), pmA)
    wtA  = meta_wavetable(accA)
    envA = meta_envelope(wtA)
    accB = meta_phase_acc(ratio_hz(nB, dB), pmB)
    wtB  = meta_wavetable(accB)
    envB = meta_envelope(wtB)
    accC = meta_phase_acc(ratio_hz(nC, dC), pmC)
    wtC  = meta_wavetable(accC)
    envC = meta_envelope(wtC)
    accD = meta_phase_acc(ratio_hz(nD, dD), mux(fbOn, 0, z1(envD) * feedback))
    wtD  = meta_wavetable(accD)
    envD = meta_envelope(wtD)
    // The algorithm (arm k = algorithm k; arm 0 is never chosen)
    pmA = mux(algorithm, 0, envB, envB, envB + envC, envB + envD, envB + envC + envD, 0, envB, 0, 0, envD, 0)
    pmB = mux(algorithm, 0, envC, envC + envD, 0, envC, 0, envC, 0, envC + envD, 0, envD, 0)
    pmC = mux(algorithm, 0, envD, 0, envD, 0, 0, envD, envD, 0, envD, envD, 0)
    mix = mux(algorithm, 0, envA, envA, envA, envA, envA, envA + envB, envA + envC, envA + envB, envA + envB + envC,
              envA + envB + envC, envA + envB + envC + envD)
  }
  out  = mix * voice.velocity
  done = mux(algorithm, true, envA.done, envA.done, envA.done, envA.done, envA.done, envA.done && envB.done,
             envA.done && envC.done, envA.done && envB.done, envA.done && envB.done && envC.done,
             envA.done && envB.done && envC.done, envA.done && envB.done && envC.done && envD.done)

  // The circuit: one row per operator, D on top (as in the algorithm picker), each row's modulation switch at the end
  // of the row above it; the output on the right.
  layout {
    node hq at (0, -132)
    node hq.default at (-36, -132)
    node algorithm at (0, -100)
    node algorithm.default at (-36, -100)
    node nD at (0, 0)
    node dD at (0, 36)
    node accD.hz at (56, -12)
    node accD at (196, 0)
    node wtD at (360, 0)
    node envD at (608, 60)
    comment "D" at (0, -28)
    node nC at (0, 300)
    node dC at (0, 336)
    node accC.hz at (56, 288)
    node accC at (196, 300)
    node wtC at (360, 300)
    node envC at (608, 360)
    comment "C" at (0, 272)
    node nB at (0, 600)
    node dB at (0, 636)
    node accB.hz at (56, 588)
    node accB at (196, 600)
    node wtB at (360, 600)
    node envB at (608, 660)
    comment "B" at (0, 572)
    node nA at (0, 900)
    node dA at (0, 936)
    node accA.hz at (56, 888)
    node accA at (196, 900)
    node wtA at (360, 900)
    node envA at (608, 960)
    comment "A" at (0, 872)
    node accD.pm.in1.a at (836, -56)
    node accD.pm at (140, 52)
    node accD.pm.in0 at (104, 80)
    node accD.pm.in1 at (92, 92)
    node feedback at (0, 116)
    node fbOn at (0, 80)
    node fbOn.default at (-36, 80)
    wire accD.pm.out -> accD.pm via ((188, 80), (188, 40))
    wire accD.pm.in1.a.out -> accD.pm.in1.a via ((888, -44), (888, -64), (76, -64), (76, 100))
    node pmC at (896, 40)
    wire pmC.out -> accC.pm via ((948, 148), (948, 268), (180, 268), (180, 340))
    wire algorithm.out -> pmC.index via ((880, -92), (880, 52))
    node pmB at (896, 340)
    wire pmB.out -> accB.pm via ((948, 448), (948, 568), (180, 568), (180, 640))
    wire algorithm.out -> pmB.index via ((880, -92), (880, 352))
    node pmA at (896, 640)
    wire pmA.out -> accA.pm via ((948, 748), (948, 868), (180, 868), (180, 940))
    wire algorithm.out -> pmA.index via ((880, -92), (880, 652))
    node pmA.in3 at (836, 700)
    node pmA.in4 at (836, 716)
    node pmA.in5 at (836, 732)
    node pmA.in5.a at (836, 692)
    node pmB.in2 at (836, 384)
    node pmB.in8 at (836, 480)
    node pmA.in0 at (860, 660)
    node pmA.in6 at (860, 756)
    node pmA.in8 at (860, 788)
    node pmA.in9 at (860, 804)
    node pmA.in11 at (860, 836)
    node pmB.in0 at (860, 360)
    node pmB.in3 at (860, 408)
    node pmB.in5 at (860, 440)
    node pmB.in7 at (860, 472)
    node pmB.in9 at (860, 504)
    node pmB.in11 at (860, 536)
    node pmC.in0 at (860, 60)
    node pmC.in2 at (860, 92)
    node pmC.in4 at (860, 124)
    node pmC.in5 at (860, 140)
    node pmC.in8 at (860, 188)
    node pmC.in11 at (860, 236)
    node mix at (1160, 860)
    node done.in at (1160, 560)
    wire algorithm.out -> mix.index via ((1144, -92), (1144, 872))
    wire algorithm.out -> done.in.index via ((1144, -92), (1144, 572))
    node mix.in6 at (1104, 968)
    node mix.in7 at (1104, 984)
    node mix.in8 at (1104, 1000)
    node mix.in9 at (1104, 1016)
    node mix.in9.a at (1060, 1008)
    node mix.in10 at (1104, 1032)
    node mix.in10.a at (1060, 1024)
    node mix.in11 at (1104, 1048)
    node mix.in11.a at (1060, 1040)
    node mix.in11.a.a at (1016, 1032)
    node done.in.in6 at (1104, 668)
    node done.in.in7 at (1104, 684)
    node done.in.in8 at (1104, 700)
    node done.in.in9 at (1104, 716)
    node done.in.in9.a at (1060, 708)
    node done.in.in10 at (1104, 732)
    node done.in.in10.a at (1060, 724)
    node done.in.in11 at (1104, 748)
    node done.in.in11.a at (1060, 740)
    node done.in.in11.a.a at (1016, 732)
    node mix.in0 at (1124, 880)
    node done.in.in0 at (1124, 580)
    node out.in at (1224, 960)
    node out.in.b at (1090, 1100)
    node out at (1280, 968)
    node done at (1224, 660)
  }
}

// An operator's frequency: the note's (voice.hz) times the exact ratio n / d. n = 0 stops following the note (the Phase
// accumulator's frequency bar is then a fixed frequency).
patch ratio_hz {
  param n = 1 [0..32]
  param d = 1 [1..32]
  out   hz : audio
  hz = voice.hz * (n / max(d, 1))
}
