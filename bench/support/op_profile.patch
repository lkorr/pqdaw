@@ -0,0 +1,49 @@
+#pragma once
+// OP.0 THROWAWAY instrumentation (not committed): rdtsc scopes per engine stage and per unit.
+#include <cstdint>
+#include <cstring>
+#include <intrin.h>
+namespace pq::engine::opprof {
+enum : uint32_t { kEngine, kEnginePre, kProgram, kHook, kTimelineNotes, kClips, kAutomation, kUnits, kEvents, kMeters, kOutput, kEnginePost, kCount };
+inline const char* const kStageNames[kCount] = {"engine total", "engine pre (params, live input)", "program total", "hook (timeline + recorder + metronome)",
+                                                "  timeline notes", "  clip players", "  automation", "units (sum)", "  of which event sources / note stages",
+                                                "meters", "output copy", "engine post (clicks, quiet scan)"};
+struct UnitRow {
+  char name[96];
+  uint64_t cycles, runs, idle;
+  bool voices;
+};
+struct Table {
+  uint64_t stage[kCount];
+  uint64_t blocks;
+  UnitRow units[2048];
+  uint32_t numUnits;
+};
+inline Table& table() noexcept {
+  static Table t{};
+  return t;
+}
+inline uint32_t unitRow(const char* name, bool voices) noexcept {
+  Table& t = table();
+  for (uint32_t i = 0; i < t.numUnits; ++i)
+    if (std::strncmp(t.units[i].name, name, sizeof t.units[i].name - 1) == 0) return i;
+  if (t.numUnits == 2048) return 2047;
+  UnitRow& r = t.units[t.numUnits];
+  std::strncpy(r.name, name, sizeof r.name - 1);
+  r.voices = voices;
+  return t.numUnits++;
+}
+inline void reset() noexcept {
+  Table& t = table();
+  std::memset(t.stage, 0, sizeof t.stage);
+  t.blocks = 0;
+  for (uint32_t i = 0; i < t.numUnits; ++i) t.units[i].cycles = t.units[i].runs = t.units[i].idle = 0;
+}
+struct Scope {
+  uint64_t& acc;
+  uint64_t t0;
+  explicit Scope(uint64_t& a) noexcept : acc(a), t0(__rdtsc()) {}
+  explicit Scope(uint32_t stage) noexcept : acc(table().stage[stage]), t0(__rdtsc()) {}
+  ~Scope() { acc += __rdtsc() - t0; }
+};
+}  // namespace pq::engine::opprof
