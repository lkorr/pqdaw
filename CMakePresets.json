{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "dev: unoptimised, debug info, asserts on (static release CRT)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "/Zi /Od /Ob0",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/Zi /Od /Ob0"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release: fully optimised, asserts off",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "/O2 /Ob2 /DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Ob2 /Oi /Ot /GL /DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/LTCG /OPT:REF /OPT:ICF",
        "CMAKE_STATIC_LINKER_FLAGS_RELEASE": "/LTCG"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
