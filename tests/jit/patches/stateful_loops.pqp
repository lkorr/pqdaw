// Patches for the JIT tests (T1b.1): every simple stateful atom, mux/demux, fast_ and exact transcendentals INSIDE
// a per-sample feedback loop (the cycle through z1 `fb`), where the JIT generates them inline instead of calling
// the dsp kernels — global (scalar code) and per voice (8-lane code).

patch LoopAtomsGlobal {
  in x : audio
  param thr = 0.1 [0..0.5]
  out o1 : audio
  out o2 : audio
  out b1 : bool
  fb  = z1(y, init: 0.25)
  s   = schmitt(x + fb * 0.5, -thr, thr)
  r   = rise(s)
  f   = fall(s)
  c   = change(s)
  sf  = srff(r, f)
  d   = dff(s, c)
  t   = tff(sf, r)
  cnt = counter(r, f, t && !s, wrap: 5)
  cd  = clockdiv(c, 3)
  p   = pulse(abs(fb) * 0.001 + 0.0005)
  tm  = timer(r || p, 0.001)
  sh  = samplehold(x, cd)
  la  = latch(fb, tm)
  ph  = phasor(200 + fb * 100)
  sn  = sine_hz(300 + fb * 50, reset: r)
  q   = demux(cnt, ph)
  y   = mux(cnt, sh, la, fb * 0.9, x) * 0.5
        + (gate_to_real(d) + gate_to_real(t) + gate_to_real(sf) + gate_to_real(cd) + gate_to_real(tm)) * 0.05
        + (q.out1 + q.out0 + sn * 0.1) * 0.2
        + fast_tanh(fb * 3) * 0.1 + tanh(fb * 2) * 0.05 + fast_sin(ph * 6) * 0.01 + sin(fb) * 0.01
        + exp(-abs(fb)) * 0.01 + fast_exp(-abs(fb)) * 0.01 + cents_to_hz(fb * 100, ref: 1) * 0.001
  o1 = y
  o2 = cnt + gate_to_real(p)
  b1 = s
}

patch LoopAtomsVoice {
  param thr = 0.1 [0..0.5]
  out o1 : audio voice
  out o2 : audio voice
  out mix : audio global
  x   = sine(phasor(voice.hz)) * 0.8
  fb  = z1(y, init: 0.25)
  s   = schmitt(x + fb * 0.5, -thr, thr)
  r   = rise(s)
  f   = fall(s)
  c   = change(s)
  sf  = srff(r, f)
  d   = dff(s, c)
  t   = tff(sf, r)
  cnt = counter(r, f, t && !s, wrap: 5)
  cd  = clockdiv(c, 3)
  p   = pulse(abs(fb) * 0.001 + 0.0005)
  tm  = timer(r || p || voice.trigger, 0.001)
  sh  = samplehold(x, cd)
  la  = latch(fb, tm && voice.gate)
  ph  = phasor(voice.hz * 0.5 + fb * 100)
  sn  = sine_hz(300 + fb * 50, reset: r)
  q   = demux(cnt, ph)
  y   = mux(cnt, sh, la, fb * 0.9, x) * 0.5
        + (gate_to_real(d) + gate_to_real(t) + gate_to_real(sf) + gate_to_real(cd) + gate_to_real(tm)) * 0.05
        + (q.out1 + q.out0 + sn * 0.1) * 0.2
        + fast_tanh(fb * 3) * 0.1 + tanh(fb * 2) * 0.05 + fast_sin(ph * 6) * 0.01 + sin(fb) * 0.01
        + exp(-abs(fb)) * 0.01 + fast_exp(-abs(fb)) * 0.01 + pow(abs(fb) + 1, 0.5) * 0.01
  o1 = y
  o2 = cnt * voice.velocity
  mix = voice_sum(y)
}
