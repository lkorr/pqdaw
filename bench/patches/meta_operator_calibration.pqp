// TMM.12: pq_bench_render's operator/meta-* benchmarks: the Meta Operator (stdlib/devices/meta_operator.pqp) as an
// instrument, against operator_calibration.pqp's OpFour (the stock Operator with the same work: four sine operators,
// algorithm 1, feedback; no pitch envelope, LFO, filter, glide or spread). Standalone, each Wavetable reads the
// engine's default table (a sine): the frame-table read costs the same for any one-keyframe table.
//   MoSine   algorithm 1 (D → C → B → A), feedback 0.3, four sine operators
//   MoHq     MoSine with hq = 2 (the operators oversampled ×2)
//   MoAdd    algorithm 11 (four carriers summed: the widest output sum)
//   MoNoFb   MoSine without D's feedback loop (fbOn 0, the device's default: no per-sample loop)
import "../../stdlib/devices/meta_operator.pqp"

patch MoSine {
  out out  : audio voice mono
  out done : bool voice mono
  o    = meta_operator(algorithm: 1, fbOn: 1, feedback: 0.3, nB: 2, nC: 3, dC: 2, nD: 7, dD: 4)
  out  = o
  done = o.done
}

patch MoHq {
  out out  : audio voice mono
  out done : bool voice mono
  o    = meta_operator(algorithm: 1, hq: 2, fbOn: 1, feedback: 0.3, nB: 2, nC: 3, dC: 2, nD: 7, dD: 4)
  out  = o
  done = o.done
}

patch MoAdd {
  out out  : audio voice mono
  out done : bool voice mono
  o    = meta_operator(algorithm: 11, nB: 2, nC: 3, nD: 4)
  out  = o
  done = o.done
}

patch MoNoFb {
  out out  : audio voice mono
  out done : bool voice mono
  o    = meta_operator(algorithm: 1, nB: 2, nC: 3, dC: 2, nD: 7, dD: 4)
  out  = o
  done = o.done
}
