// M1 review probe fold_scan (docs/reviews/M1/probes/fold_scan.pqp, M4) extended for QUESTIONS Q94: every exact
// transcendental of a folded literal minus the same function of a param with that value, times 1e9. `y` runs at
// param rate (Control region, 8 lanes), `z` the same on a global audio-rate signal (1 lane: `one` is an
// audio-rate 1.0). With the default params every sample of every channel is exactly 0 when constant folding,
// 8-lane and 1-lane kernels agree bit for bit (tests/jit/test_jit.cpp, both backends). Not compared with the
// reference evaluator: it computes transcendentals independently in double (a few ulp apart), and this probe
// multiplies one ulp by 1e9.
patch foldscan {
  param a0 = 0.4464
  param b0 = 1.7372
  d0 = (pow(0.4464, 1.7372) - pow(a0, b0)) * 1000000000
  e0 = (pow(0.4464, 1.7372) - pow(a0 * one, b0 * one)) * 1000000000
  param a1 = 2.3031
  d1 = (tanh(2.3031) - tanh(a1)) * 1000000000
  e1 = (tanh(2.3031) - tanh(a1 * one)) * 1000000000
  param a2 = 1.5115
  d2 = (sin(1.5115) - sin(a2)) * 1000000000
  e2 = (sin(1.5115) - sin(a2 * one)) * 1000000000
  param a3 = 1.9722
  d3 = (exp(1.9722) - exp(a3)) * 1000000000
  e3 = (exp(1.9722) - exp(a3 * one)) * 1000000000
  param a4 = 0.3269
  d4 = (log(0.3269) - log(a4)) * 1000000000
  e4 = (log(0.3269) - log(a4 * one)) * 1000000000
  param a5 = 2.5155
  d5 = (tan(2.5155) - tan(a5)) * 1000000000
  e5 = (tan(2.5155) - tan(a5 * one)) * 1000000000
  param a6 = 2.2987
  param b6 = -2.4895
  d6 = (pow(2.2987, -2.4895) - pow(a6, b6)) * 1000000000
  e6 = (pow(2.2987, -2.4895) - pow(a6 * one, b6 * one)) * 1000000000
  param a7 = 1.3639
  d7 = (tanh(1.3639) - tanh(a7)) * 1000000000
  e7 = (tanh(1.3639) - tanh(a7 * one)) * 1000000000
  param a8 = 0.7248
  d8 = (sin(0.7248) - sin(a8)) * 1000000000
  e8 = (sin(0.7248) - sin(a8 * one)) * 1000000000
  param a9 = 2.7092
  d9 = (exp(2.7092) - exp(a9)) * 1000000000
  e9 = (exp(2.7092) - exp(a9 * one)) * 1000000000
  param a10 = 0.1251
  d10 = (log(0.1251) - log(a10)) * 1000000000
  e10 = (log(0.1251) - log(a10 * one)) * 1000000000
  param a11 = 2.8205
  d11 = (tan(2.8205) - tan(a11)) * 1000000000
  e11 = (tan(2.8205) - tan(a11 * one)) * 1000000000
  param a12 = 0.689
  param b12 = -0.3894
  d12 = (pow(0.689, -0.3894) - pow(a12, b12)) * 1000000000
  e12 = (pow(0.689, -0.3894) - pow(a12 * one, b12 * one)) * 1000000000
  param a13 = 0.1357
  d13 = (tanh(0.1357) - tanh(a13)) * 1000000000
  e13 = (tanh(0.1357) - tanh(a13 * one)) * 1000000000
  param a14 = 1.3418
  d14 = (sin(1.3418) - sin(a14)) * 1000000000
  e14 = (sin(1.3418) - sin(a14 * one)) * 1000000000
  param a15 = 0.7376
  d15 = (exp(0.7376) - exp(a15)) * 1000000000
  e15 = (exp(0.7376) - exp(a15 * one)) * 1000000000
  param a16 = 0.6954
  d16 = (log(0.6954) - log(a16)) * 1000000000
  e16 = (log(0.6954) - log(a16 * one)) * 1000000000
  param a17 = 0.9049
  d17 = (tan(0.9049) - tan(a17)) * 1000000000
  e17 = (tan(0.9049) - tan(a17 * one)) * 1000000000
  param a18 = 2.5209
  param b18 = 0.2823
  d18 = (pow(2.5209, 0.2823) - pow(a18, b18)) * 1000000000
  e18 = (pow(2.5209, 0.2823) - pow(a18 * one, b18 * one)) * 1000000000
  param a19 = 1.9448
  d19 = (tanh(1.9448) - tanh(a19)) * 1000000000
  e19 = (tanh(1.9448) - tanh(a19 * one)) * 1000000000
  param a20 = 2.978
  d20 = (sin(2.978) - sin(a20)) * 1000000000
  e20 = (sin(2.978) - sin(a20 * one)) * 1000000000
  param a21 = 0.4066
  d21 = (exp(0.4066) - exp(a21)) * 1000000000
  e21 = (exp(0.4066) - exp(a21 * one)) * 1000000000
  param a22 = 2.1784
  d22 = (log(2.1784) - log(a22)) * 1000000000
  e22 = (log(2.1784) - log(a22 * one)) * 1000000000
  param a23 = 2.8125
  d23 = (tan(2.8125) - tan(a23)) * 1000000000
  e23 = (tan(2.8125) - tan(a23 * one)) * 1000000000
  param a24 = 2.4986
  param b24 = 0.8515
  d24 = (pow(2.4986, 0.8515) - pow(a24, b24)) * 1000000000
  e24 = (pow(2.4986, 0.8515) - pow(a24 * one, b24 * one)) * 1000000000
  param a25 = 0.9449
  d25 = (tanh(0.9449) - tanh(a25)) * 1000000000
  e25 = (tanh(0.9449) - tanh(a25 * one)) * 1000000000
  param a26 = 2.6533
  d26 = (sin(2.6533) - sin(a26)) * 1000000000
  e26 = (sin(2.6533) - sin(a26 * one)) * 1000000000
  param a27 = 1.5406
  d27 = (exp(1.5406) - exp(a27)) * 1000000000
  e27 = (exp(1.5406) - exp(a27 * one)) * 1000000000
  param a28 = 0.1519
  d28 = (log(0.1519) - log(a28)) * 1000000000
  e28 = (log(0.1519) - log(a28 * one)) * 1000000000
  param a29 = 2.4023
  d29 = (tan(2.4023) - tan(a29)) * 1000000000
  e29 = (tan(2.4023) - tan(a29 * one)) * 1000000000
  param a30 = 386.3137
  param b30 = 261.6256
  d30 = (cents_to_hz(386.3137, 261.6256) - cents_to_hz(a30, b30)) * 1000000000
  e30 = (cents_to_hz(386.3137, 261.6256) - cents_to_hz(a30 * one, b30 * one)) * 1000000000
  param a31 = -1200.5
  param b31 = 440
  d31 = (cents_to_hz(-1200.5, 440) - cents_to_hz(a31, b31)) * 1000000000
  e31 = (cents_to_hz(-1200.5, 440) - cents_to_hz(a31 * one, b31 * one)) * 1000000000
  param a32 = 659.255
  param b32 = 440
  d32 = (hz_to_cents(659.255, 440) - hz_to_cents(a32, b32)) * 1000000000
  e32 = (hz_to_cents(659.255, 440) - hz_to_cents(a32 * one, b32 * one)) * 1000000000
  param a33 = 97.9989
  param b33 = 261.6256
  d33 = (hz_to_cents(97.9989, 261.6256) - hz_to_cents(a33, b33)) * 1000000000
  e33 = (hz_to_cents(97.9989, 261.6256) - hz_to_cents(a33 * one, b33 * one)) * 1000000000
  param a34 = -6.0206
  d34 = (db_to_gain(-6.0206) - db_to_gain(a34)) * 1000000000
  e34 = (db_to_gain(-6.0206) - db_to_gain(a34 * one)) * 1000000000
  param a35 = 12.5
  d35 = (db_to_gain(12.5) - db_to_gain(a35)) * 1000000000
  e35 = (db_to_gain(12.5) - db_to_gain(a35 * one)) * 1000000000
  param a36 = 0.5
  d36 = (gain_to_db(0.5) - gain_to_db(a36)) * 1000000000
  e36 = (gain_to_db(0.5) - gain_to_db(a36 * one)) * 1000000000
  param a37 = 3.7
  d37 = (gain_to_db(3.7) - gain_to_db(a37)) * 1000000000
  e37 = (gain_to_db(3.7) - gain_to_db(a37 * one)) * 1000000000
  one = z1(1, init: 1)
  out y : audio ch(38)
  out z : audio ch(38)
  y = (d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, d12, d13, d14, d15, d16, d17, d18, d19, d20, d21, d22, d23, d24, d25, d26, d27, d28, d29, d30, d31, d32, d33, d34, d35, d36, d37)
  z = (e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15, e16, e17, e18, e19, e20, e21, e22, e23, e24, e25, e26, e27, e28, e29, e30, e31, e32, e33, e34, e35, e36, e37)
}
