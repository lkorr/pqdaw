# Compiler cache, cache-friendly debug info, no module scanning (T0.x-buildspeed). Included after project(), before any target.
#
# sccache (scripts/get-sccache.ps1, pinned, SHA-256 checked) is the C/C++ compiler launcher when installed;
# builds work the same without it. scripts/build.ps1 sets its environment: one cache directory shared by every
# checkout and worktree (%LOCALAPPDATA%\pqdaw\sccache), and one sccache server per checkout whose base
# directory is that checkout's root, so the same source compiled in two worktrees hashes the same.
#
# That normalisation means a cached object may come from another worktree. Nothing compiled through the cache
# may therefore contain this checkout's absolute paths: those live in pq_build_paths (below), which is compiled
# without the launcher. __FILE__ in a cached object can still name the other worktree (same file, same line);
# the test main prints file names without directories for that reason.

set(PQ_SCCACHE "" CACHE STRING
  "sccache executable used as the compiler launcher. Empty: %LOCALAPPDATA%/pqdaw/tools/sccache/sccache.exe if it exists (scripts/get-sccache.ps1). OFF: no compiler cache.")
set(_pq_sccache "")
if(PQ_SCCACHE)
  set(_pq_sccache "${PQ_SCCACHE}")
elseif(PQ_SCCACHE STREQUAL "" AND DEFINED ENV{LOCALAPPDATA})
  file(TO_CMAKE_PATH "$ENV{LOCALAPPDATA}/pqdaw/tools/sccache/sccache.exe" _pq_candidate)
  if(EXISTS "${_pq_candidate}")
    set(_pq_sccache "${_pq_candidate}")
  endif()
endif()
# Read back by scripts/build.ps1 (cache statistics).
set(PQ_SCCACHE_LAUNCHER "${_pq_sccache}" CACHE INTERNAL "sccache in use as the compiler launcher (empty: none)")
if(_pq_sccache)
  message(STATUS "pqdaw: compiler cache: ${_pq_sccache}")
  # Normal variables: they initialise every target's <LANG>_COMPILER_LAUNCHER, third-party ones included.
  set(CMAKE_C_COMPILER_LAUNCHER "${_pq_sccache}")
  set(CMAKE_CXX_COMPILER_LAUNCHER "${_pq_sccache}")
  # sccache cannot cache compiles that use a precompiled header (/Yu /Fp): SDL3's ~220 C files do. Without the
  # PCH each of them re-reads SDL_internal.h on a cold compile, and every one becomes a cache hit afterwards.
  set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
else()
  message(STATUS "pqdaw: compiler cache: none (run scripts/get-sccache.ps1 to enable)")
endif()

# No C++20 named modules in pqdaw or its dependencies. CMake 3.28+ otherwise adds a dependency-scan step
# (a full extra preprocessor run of cl /scanDependencies, not cacheable) before every C++ compile.
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)

# Debug info embedded in each object (/Z7) instead of a shared per-target PDB (/Zi): objects are then
# self-contained and cacheable, and parallel compiles stop serialising on mspdbsrv. The linker still writes
# the executable's PDB. Release builds carry no debug info. CMP0141 is NEW here (cmake_minimum_required) and,
# through CMAKE_POLICY_DEFAULT_CMP0141 in the top-level CMakeLists.txt, in third-party projects.
set(CMAKE_MSVC_DEBUG_INFORMATION_FORMAT "$<$<CONFIG:RelWithDebInfo>:Embedded>")
# Build trees configured before this change cached /Zi in the per-config flags (the dev preset set it): drop it,
# or /Zi would override /Z7 and make every compile uncacheable.
foreach(_pq_var CMAKE_C_FLAGS_RELWITHDEBINFO CMAKE_CXX_FLAGS_RELWITHDEBINFO)
  string(REGEX REPLACE "(^| )[/-]Zi( |$)" " " ${_pq_var} "${${_pq_var}}")
endforeach()

# Absolute paths of this checkout, for code that needs them at run time (test data, source assets, helper
# executables). Defined in a single generated translation unit compiled WITHOUT the compiler cache (an object
# from another worktree would carry that worktree's paths) and declared by cmake/pq_build_paths.h. Linked by
# pq_add_test and by the modules that use it (pq_use_build_paths in PqModule.cmake).
#   pq_build_source_dir         <source>
#   pq_build_test_data_dir      <source>/tests
#   pq_build_source_assets_dir  <source>/assets
#   pq_build_alloc_trap_probe   the pq_alloc_trap_abort_probe executable (tests/CMakeLists.txt)
#   pq_build_pqc_exe            the pqc executable (tools/pqc)
function(pq_define_build_paths)
  set(_out "${CMAKE_BINARY_DIR}/pq_build_paths/pq_build_paths.cpp")
  file(GENERATE OUTPUT "${_out}" CONTENT
"// GENERATED by cmake/PqCompilerCache.cmake. This checkout's absolute paths (see cmake/pq_build_paths.h).
#include \"pq_build_paths.h\"
extern \"C\" const char pq_build_source_dir[] = \"${PQ_SOURCE_DIR}\";
extern \"C\" const char pq_build_test_data_dir[] = \"${PQ_SOURCE_DIR}/tests\";
extern \"C\" const char pq_build_source_assets_dir[] = \"${PQ_SOURCE_DIR}/assets\";
extern \"C\" const char pq_build_alloc_trap_probe[] = \"$<TARGET_FILE:pq_alloc_trap_abort_probe>\";
extern \"C\" const char pq_build_pqc_exe[] = \"$<TARGET_FILE:pqc>\";
")
  add_library(pq_build_paths STATIC "${_out}")
  target_include_directories(pq_build_paths PUBLIC "${PQ_SOURCE_DIR}/cmake")
  set_target_properties(pq_build_paths PROPERTIES C_COMPILER_LAUNCHER "" CXX_COMPILER_LAUNCHER "")
  pq_target_defaults(pq_build_paths)
endfunction()
